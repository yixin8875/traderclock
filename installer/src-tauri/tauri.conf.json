{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TradeClock Setup",
  "version": "0.1.0",
  "identifier": "com.tradeclock.setup",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "TradeClock 安装程序",
        "width": 800,
        "height": 520,
        "minWidth": 800,
        "minHeight": 520,
        "maxWidth": 800,
        "maxHeight": 520,
        "resizable": false,
        "center": true,
        "decorations": true,
        "theme": "Dark",
        "backgroundColor": "#0B1120",
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
